<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\NativeVersion.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>$(MccVersion)</Version>
    <AssemblyVersion>$(MccVersion).0</AssemblyVersion>
    <FileVersion>$(MccVersion).0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MeshCore.Windows.Core/MeshCore.Windows.Core.csproj" />
    <ProjectReference Include="../MeshCore.Windows.Bluetooth/MeshCore.Windows.Bluetooth.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <Content Include="../assets/NAudio-LICENSE.txt" Link="NAudio-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../assets/multi_board_shell.html" Link="multi_board_shell.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../artifacts/radio.html" Link="radio.html" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../artifacts/radio.html')" />
    <Content Include="../assets/meshcore-command.ico" Link="meshcore-command.ico" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../firmware/**/*" Link="firmware/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="'$(MCC_FIRMWARE_DIR)' == ''" />
    <Content Include="$(MCC_FIRMWARE_DIR)/**/*" Link="firmware/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="'$(MCC_FIRMWARE_DIR)' != ''" />
    <Content Include="../artifacts/espflash.exe" Link="espflash.exe" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('../artifacts/espflash.exe')" />
    <Content Include="../artifacts/mercury/*" Link="mercury/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
  <Target Name="RequireNativeWebUi" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('../artifacts/radio.html')" Text="Generate the native web interface first with node 'MeshCore Windows/Build-WebUI.mjs', or use Build-Preview.ps1." />
  </Target>
</Project>
